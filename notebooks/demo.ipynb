# ==============================
# 1. Setup
# ==============================
import sys, os
sys.path.append(os.path.abspath("../src"))

import numpy as np
import matplotlib.pyplot as plt
from tqdm import tqdm

from tools import compute_ndvi, calc_mean_ndvi
from llm_agent import GeospatialAgent

# ==============================
# 2. Install / import geospatial libraries
# ==============================
# These must be in requirements.txt
import pystac_client
import planetary_computer as pc
import rioxarray
import geopandas as gpd
import folium

# ==============================
# 3. Search for a Sentinel-2 scene (Planetary Computer STAC)
# ==============================
catalog = pystac_client.Client.open("https://planetarycomputer.microsoft.com/api/stac/v1")

# Define AOI (bbox: [minx, miny, maxx, maxy])
bbox = [-122.06, 37.29, -121.88, 37.42]  # around San Jose
search = catalog.search(
    collections=["sentinel-2-l2a"],
    bbox=bbox,
    datetime="2025-11-01/2025-12-05",
    query={"eo:cloud_cover": {"lt": 20}},
    limit=1
)

items = list(search.get_items())
if not items:
    raise RuntimeError("No Sentinel-2 items found for that bbox / date range")
item = items[0]
print("Selected item:", item.id)

# ==============================
# 4. Load Red (B04) and NIR (B08) bands
# ==============================
red_href = pc.sign(item.assets["B04"].href)
nir_href = pc.sign(item.assets["B08"].href)

red = rioxarray.open_rasterio(red_href, masked=True).squeeze()
nir = rioxarray.open_rasterio(nir_href, masked=True).squeeze()

print(f"Red band shape: {red.shape}, NIR band shape: {nir.shape}")

# Convert to numpy arrays for tools.py
red_arr = red.values.astype(np.float32)
nir_arr = nir.values.astype(np.float32)

# ==============================
# 5. Compute NDVI
# ==============================
ndvi = compute_ndvi(red_arr, nir_arr)
mean_ndvi = calc_mean_ndvi(ndvi)
print("Mean NDVI:", mean_ndvi)

# ==============================
# 6. Visualize NDVI
# ==============================
plt.figure(figsize=(8, 6))
plt.imshow(ndvi, cmap="RdYlGn")
plt.colorbar()
plt.title(f"NDVI - {item.id}")
plt.show()

# ==============================
# 7. Initialize agent
# ==============================
def mock_llm(prompt):
    # For demo purposes, prints prompt snippet
    return f"LLM received prompt:\n{prompt[:150]}..."

agent = GeospatialAgent(mock_llm)

# ==============================
# 8. Agent queries
# ==============================
context = {"mean_ndvi": mean_ndvi}
question_1 = "What does the average NDVI value tell us about vegetation health in this scene?"
question_2 = "Are there any areas of very high or very low vegetation?"

print(agent.run(question_1, context))
print(agent.run(question_2, context))

# ==============================
# 9. Optional: show map overlay (folium)
# ==============================
# Define center
center = [(bbox[1]+bbox[3])/2, (bbox[0]+bbox[2])/2]
m = folium.Map(location=center, zoom_start=12)
# Add NDVI as image overlay (optional: scale down large images for demo)
folium.raster_layers.ImageOverlay(
    image=ndvi,
    bounds=[[bbox[1], bbox[0]], [bbox[3], bbox[2]]],
    colormap=lambda x: (1-x, x, 0, 0.6)
).add_to(m)
m
